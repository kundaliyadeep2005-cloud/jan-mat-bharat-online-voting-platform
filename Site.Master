<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="janmatbharat.SiteMaster" %>
<!DOCTYPE html>
<html lang="hi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> — जन-मत भारत</title>
    <link rel="stylesheet" href="<%=ResolveUrl("~/Content/Site.css")%>" />
    <asp:ContentPlaceHolder ID="NavActive" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
<form id="frmSite" runat="server">
<%
    string pageName = System.IO.Path.GetFileName(Request.Path) ?? "";
%>

    <!-- ══ NAVBAR ══ -->
    <header>
        <nav class="jm-nav">
            <a class="jm-brand" id="lnkBrand" href='<%=ResolveUrl("~/Default.aspx")%>'>जन-मत भारत</a>
            <ul class="jm-nav-links">
                <li><a href='<%=ResolveUrl("~/Default.aspx")%>' id="lnkNavHome" class='<%= (pageName.Equals("Default.aspx", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(pageName) || pageName.Equals("Default", StringComparison.OrdinalIgnoreCase)) ? "active" : "" %>'>HOME</a></li>
                <li><a href='<%=ResolveUrl("~/About.aspx")%>' id="lnkNavAbout" class='<%= (pageName.Equals("About.aspx", StringComparison.OrdinalIgnoreCase) || pageName.Equals("About", StringComparison.OrdinalIgnoreCase)) ? "active" : "" %>'>OUR MISSION</a></li>
                <li><a href='<%=ResolveUrl("~/Support.aspx")%>' id="lnkNavSupport" class='<%= (pageName.Equals("Support.aspx", StringComparison.OrdinalIgnoreCase) || pageName.Equals("Support", StringComparison.OrdinalIgnoreCase)) ? "active" : "" %>'>SUPPORT CENTER</a></li>
                <li><a href='<%=ResolveUrl("~/CastVote.aspx")%>' id="lnkNavCastVote" class='<%= (pageName.Equals("CastVote.aspx", StringComparison.OrdinalIgnoreCase) || pageName.Equals("CastVote", StringComparison.OrdinalIgnoreCase)) ? "active" : "" %>'>CAST YOUR VOTE</a></li>
                <li><a href='<%=ResolveUrl("~/VoterProfile.aspx")%>' id="lnkNavVoterProfile" class='<%= (pageName.Equals("VoterProfile.aspx", StringComparison.OrdinalIgnoreCase) || pageName.Equals("VoterProfile", StringComparison.OrdinalIgnoreCase)) ? "active" : "" %>'>VOTER PROFILE</a></li>
            </ul>
            <div class="jm-nav-user">
                <span class="jm-user-pill" id="lblNavUser">Rahul Gandhi</span>
                <a href='<%=ResolveUrl("~/Login.aspx")%>' class="jm-btn-signout" id="btnSignOut">SIGN OUT</a>
            </div>
        </nav>
    </header>

    <!-- ══ MAIN CONTENT ══ -->
    <main id="main-content">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <!-- ══ FOOTER ══ -->
    <asp:ContentPlaceHolder ID="FooterContent" runat="server">
        <footer class="jm-footer">
            <div class="jm-footer-grid">
                <!-- Col 1 -->
                <div class="jm-footer-col">
                    <div class="jm-footer-col1-brand">
                        <span class="f-icon">&#x2714;</span>
                        <span class="f-brand-name">Jan-Mat Bharat</span>
                    </div>
                    <p>Empowering every citizen of India through a transparent, secure, and accessible digital civic engagement platform. Government of India Initiative.</p>
                </div>

                <!-- Col 2 -->
                <div class="jm-footer-col">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">Accessibility Statement</a></li>
                        <li><a href="#">Cyber Security Guidelines</a></li>
                    </ul>
                </div>

                <!-- Col 3 -->
                <div class="jm-footer-col">
                    <h4>Contact Us</h4>
                    <div class="f-contact-row">&#x2709; support@janmat.gov.in</div>
                    <div class="f-contact-row">&#x1F4DE; 1800-11-2024</div>
                </div>
            </div>

            <div class="jm-footer-bar">
                <span>&copy; 2026 Jan-Mat Bharat. National Informatics Centre (NIC).</span>
                <span class="jm-footer-icons">&#x1F1EE;&#x1F1F3; &#x1F3DB; &#x1F512;</span>
            </div>
        </footer>
    </asp:ContentPlaceHolder>

</form>
</body>
</html>
